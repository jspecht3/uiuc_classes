@techreport{tong,
  author       = {Tong, L S},
  title        = {BOILING CRISIS AND CRITICAL HEAT FLUX.},
  institution  = {Westinghouse Electric Corp., Pittsburgh, Pa.},
  annote       = {The ratio of the predicted critical heat flux (CHF) to the reactor heat flux is used as an index of the power capability of water reactors. Numerous boiling heat-transfer and two-phase-flow studies over the past 15 years have put emphasis on exploring the boiling-crisis mechanisms and on perfecting the CHF predictions. Unfortunately, the problem is more complicated than was thought. Thus far no overall analytical solution has been obtained, and the design equations for CHF predictions arc empirical. In this review various types of boiling crisis are categorized according to four major flow patterns: pool boiling, bubbly flow, annular flow, and normal flow across a cylinder. The physical mechanisms of these boiling crises are described. Experimental observations are summarized and used for verifying various analyses. The missing links in the analyses are identified, and future work is recommended.},
  doi          = {10.2172/4629988},
  url          = {https://www.osti.gov/biblio/4629988},
  place        = {United States},
  year         = {1972},
  month        = {01}}

@book{tk,
  author       = {Todreas, N E and Kazami, M J},
  title        = {Nuclear systems 1},
  annote       = {The book covers thermal hydraulic design fundamentals and analysis of the core of a nuclear reactor. Other components of the nuclear power plant, such as the pressurizer, the containment and the entire primary coolant system are addressed. The book reflects the importance of such considerations in thermal engineering of a modern nuclear power plant.},
  url          = {https://www.osti.gov/biblio/6388266},
  place        = {United States},
  publisher    = {New York, NY (USA); Hemisphere Publishing},
  year         = {1990},
  month        = {01}}


